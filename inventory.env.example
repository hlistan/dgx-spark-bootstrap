# Site inventory: everything that is specific to one installation (addresses, host name, SSH alias).
# Copy to inventory.env and edit. inventory.env is gitignored; `make deploy` copies it to the Spark.
# Plain KEY=value lines, comments on their own lines, no quoting or expansion: safe to `source` from sh,
# `include` from make and parse line by line anywhere.
# Secrets (SPARK_API_KEY, GRAFANA_ADMIN_PASSWORD) do not belong here: they live in the .env files on the Spark.
# The addresses below are from the documentation ranges (RFC 5737) and reach nothing.

# ~/.ssh/config alias for the Spark (user, address and key are set there)
SPARK_SSH=spark
# label on every metric (host_id); the Spark's hostname is a good choice
SPARK_HOSTNAME=spark
# the Spark's LAN IP (DHCP reservation); every service binds only here
SPARK_HOST=192.0.2.10
# hosts the optional firewall (host/) lets through; several: space-separated
SPARK_ALLOWED_IPS=192.0.2.20
# deploy directory on the Spark, relative to the SSH user's home
SPARK_DEPLOY_DIR=spark

# Inference (inference/compose.yaml): one coding LLM. OpenAI-compatible; needs `Authorization: Bearer $SPARK_API_KEY`.
SPARK_LLM_BASE_URL=http://192.0.2.10:8000/v1
# nvidia/Qwen3.8-27B-NVFP4 + DFlash2, 256k ctx, thinking on, tools (qwen3_xml), vision
SPARK_LLM_MODEL=qwen3.8-27b
SPARK_LLM_CONTEXT=262144

# Monitoring (monitoring/compose.yaml)
SPARK_GRAFANA_URL=http://192.0.2.10:3000
# on the Spark only: `make prom` tunnels it to localhost:9090
SPARK_PROMETHEUS=127.0.0.1:9090
