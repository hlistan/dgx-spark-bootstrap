     {
      "text": "7d",
      "value": "7d",
      "selected": false
     }
    ]
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Alerts firing",
   "description": "Prometheus alert rules firing right now (monitoring/prometheus/rules/spark.yml). Details in the table below.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "noValue": "0"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Latest $window check",
   "description": "Worst result of the latest periodic analysis (analysis/spark-analyze.py, S8). Daily at 06:15, weekly Mon 06:45.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "max(spark_analysis_check{window=\"$window\"})",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "OK",
         "color": "green",
         "index": 0
        },
        "1": {
         "text": "OK",
         "color": "green",
         "index": 1
        },
        "2": {
         "text": "WARN",
         "color": "orange",
         "index": 2
        },
        "3": {
         "text": "FAIL",
         "color": "red",
         "index": 3
        }
       }
      }
     ],
     "noValue": "no data",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Failing / warning checks",
   "description": "Number of failing and warning checks in the latest $window analysis.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "spark_analysis_findings{window=\"$window\",severity=\"fail\"}",
     "instant": true,
     "legendFormat": "fail"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "spark_analysis_findings{window=\"$window\",severity=\"warn\"}",
     "instant": true,
     "legendFormat": "warn"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center",
    "orientation": "horizontal"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "fail"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "red",
           "value": 1
          }
         ]
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Analysis ran",
   "description": "When the latest $window analysis finished. Alert SparkAnalysisStale fires after 26 h without a daily run.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "spark_analysis_last_run_timestamp_seconds{window=\"$window\"} * 1000",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "dateTimeFromNow",
     "noValue": "never"
    },
    "overrides": []
   }
  },
  {
