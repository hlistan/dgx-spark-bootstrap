# Copy to inference/.env on the DGX Spark (~/spark/inference/.env). Never commit .env.

# The Spark's LAN IP (SPARK_HOST in inventory.env); the LLM port binds ONLY here. Reserve it in the router's DHCP.
# The value below is a placeholder.
SPARK_BIND_IP=192.0.2.10

# Shared API key for the LLM; every client gets the same value. openssl rand -hex 32
SPARK_API_KEY=

# LLM image: NVIDIA's NGC vLLM build from the Qwen3.8-27B Spark recipe (vLLM 0.31 + DFlash/NVFP4 fixes).
LLM_IMAGE=nvcr.io/nvidia/vllm:26.10.pre1-py3

# Share of 128 GB unified memory for the LLM. 0.60 is the recipe's value (0.70+ hung nodes during autotune).
LLM_GPU_UTIL=0.60

# Optional: HF token for gated downloads / higher rate limits.
HF_TOKEN=
