# Copy to monitoring/.env on the Spark (`make monitoring-env` does it). Never commit .env.

# The Spark's LAN IP (SPARK_HOST in inventory.env); Grafana binds only here. The value below is a placeholder.
SPARK_BIND_IP=192.0.2.10

# Grafana admin password: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# Prometheus retention: whichever limit is hit first.
PROM_RETENTION_TIME=30d
PROM_RETENTION_SIZE=20GB

# Where analysis/ writes reports and node_exporter textfile metrics on the Spark (S8; `make schedule`).
SPARK_REPORTS_DIR=/home/USER/spark-reports
