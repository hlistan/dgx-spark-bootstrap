  {
   "id": 10,
   "type": "table",
   "title": "Checks — problems first",
   "description": "Every check of the latest periodic analysis with its result and, for WARN/FAIL, the recommendation. Thresholds and logic: analysis/spark-analyze.py.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 15
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "spark_analysis_check{window=\"$window\"}",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "sortBy": [
     {
      "displayName": "Status",
      "desc": true
     }
    ]
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "No analysis yet — make analyze",
     "custom": {
      "align": "left",
      "wrapText": true,
      "cellOptions": {
       "type": "auto",
       "wrapText": true
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Status"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "custom.width",
        "value": 80
       },
       {
        "id": "custom.align",
        "value": "center"
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "OK",
            "color": "green",
            "index": 0
           },
           "1": {
            "text": "NOTE",
            "color": "blue",
            "index": 1
           },
           "2": {
            "text": "WARN",
            "color": "orange",
            "index": 2
           },
           "3": {
            "text": "FAIL",
            "color": "red",
            "index": 3
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Section"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 110
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Check"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 210
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Recommendation"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 520
       }
      ]
     }
    ]
   },
   "transformations": [
    {
     "id": "filterFieldsByName",
     "options": {
      "include": {
