  "from": "now-14d",
  "to": "now"
 },
 "timepicker": {},
 "links": [
  {
   "type": "link",
   "title": "Inference + GB10",
   "url": "/d/dgx-spark-vllm",
   "icon": "dashboard",
   "keepTime": false,
   "targetBlank": false,
   "tags": []
  },
  {
   "type": "link",
   "title": "Node Exporter Full",
   "url": "/d/rYdddlPWk",
   "icon": "dashboard",
   "keepTime": false,
   "targetBlank": false,
   "tags": []
  }
 ],
 "annotations": {
  "list": []
 },
 "templating": {
  "list": [
   {
    "name": "window",
    "label": "Analysis window",
    "type": "custom",
    "query": "24h,7d",
    "current": {
     "text": "24h",
     "value": "24h"
    },
    "hide": 0,
    "includeAll": false,
    "multi": false,
    "options": [
     {
      "text": "24h",
      "value": "24h",
      "selected": true
