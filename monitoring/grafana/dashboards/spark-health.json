  {
   "id": 7,
   "type": "table",
   "title": "Alerts now (firing and pending)",
   "description": "Every Prometheus alert that is pending or firing now. Rule definitions and summaries: monitoring/prometheus/rules/spark.yml, or `make prom` → http://localhost:9090/alerts.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 10,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "ALERTS",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "sortBy": [
     {
      "displayName": "state",
      "desc": false
     }
    ]
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "No alerts",
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "state"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "custom.width",
        "value": 90
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "firing": {
            "text": "firing",
            "color": "red",
            "index": 0
           },
           "pending": {
            "text": "pending",
            "color": "orange",
            "index": 1
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "host_id": true,
       "dgx_spark": true
      },
      "indexByName": {
       "alertstate": 0,
       "alertname": 1,
       "severity": 2
      },
      "renameByName": {
       "alertstate": "state",
       "alertname": "alert"
      }
     }
    }
   ]
  },
  {
   "id": 8,
   "type": "state-timeline",
   "title": "Alert history",
   "description": "When each alert was firing during the selected time range (only alerts that fired are listed).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 10,
    "y": 4,
    "w": 14,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "max by (alertname) (ALERTS{alertstate=\"firing\"})",
