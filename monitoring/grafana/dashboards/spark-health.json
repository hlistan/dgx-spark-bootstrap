  {
   "id": 11,
   "type": "row",
   "title": "Trends",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Benchmark: decode tok/s",
   "description": "Nightly benchmark decode speed. decode: single stream; ctx32k: at ~32k tokens of context; conc4: 4 streams summed. Dashed: SparkBenchRegression fires below this line (85% of the 14-day median). Baseline 2026-11-02: 43.5 / 44.3 / 134.8 tok/s.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "spark_bench_decode_tokens_per_second",
     "legendFormat": "{{case}}",
     "interval": "5m"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "0.85 * quantile_over_time(0.5, spark_bench_decode_tokens_per_second[14d])",
     "legendFormat": "{{case}} alert line",
     "interval": "5m"
    }
   ],
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "min"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineInterpolation": "stepAfter",
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true
     },
     "unit": "short",
     "decimals": 1
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*alert line"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          6,
          6
         ]
        }
       },
       {
        "id": "custom.lineWidth",
        "value": 1
       }
      ]
     }
    ]
   }
  },
  {
